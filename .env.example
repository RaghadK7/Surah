# ===========================================
# SURAH APP - Environment Variables Example
# ===========================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env file with real credentials!

# ===========================================
# GOOGLE SERVICES
# ===========================================
# Google Maps Platform API Keys
# Get from: https://console.cloud.google.com/google/maps-apis
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_GOOGLE_ROADS_API_KEY=your_google_roads_api_key_here

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here

# ===========================================
# OPENSTREETMAP SERVICES
# ===========================================
# OSM Overpass API Configuration
EXPO_PUBLIC_OSM_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
EXPO_PUBLIC_OSM_REQUEST_TIMEOUT=30000

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Firebase Project Configuration
# Get from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ===========================================
# API CONFIGURATION
# ===========================================
# Rate Limiting
EXPO_PUBLIC_MAX_API_CALLS_PER_MINUTE=60

# Cache Settings (in milliseconds)
EXPO_PUBLIC_CACHE_DURATION=300000

# Request Timeout (in milliseconds)
EXPO_PUBLIC_REQUEST_TIMEOUT=10000

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Add any additional API keys or services here
# EXPO_PUBLIC_CUSTOM_API_KEY=your_custom_api_key_here
# EXPO_PUBLIC_ANALYTICS_KEY=your_analytics_key_here

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Uncomment for development mode features
# EXPO_PUBLIC_DEBUG_MODE=true
# EXPO_PUBLIC_MOCK_LOCATION=true
